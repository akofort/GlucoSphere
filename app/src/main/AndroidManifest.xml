<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Spracheingabe im Chat (RecognizerIntent.ACTION_RECOGNIZE_SPEECH): the system speech
         dialog itself owns the mic, but several OEM implementations still expect the calling
         app to hold this permission too. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GlucoSphere">

        <!-- LiteRT-LM GPU backend: optional native libs it probes for at runtime. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.GlucoSphere">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth2 (Authorization Code + PKCE) redirect target for MCP servers configured
                 with AuthMethod.OAUTH2 (see domain/OAuth2.kt). singleTask above ensures this
                 reuses the existing activity instance (and its in-memory PendingOAuth2Flow state)
                 instead of spawning a second one when Chrome redirects back into the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="diabai"
                    android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.ModelDownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Hands a generated chat-answer PDF (see ChatPdfExport.kt) to the share sheet without
             granting the target app broader filesystem access; see file_paths.xml for exactly
             which directory this exposes. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>